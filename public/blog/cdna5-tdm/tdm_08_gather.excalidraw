  {
   "type": "text",
   "id": "tx143",
   "x": 49.7,
   "y": 482.2,
   "width": 900.6,
   "height": 15.6,
   "text": "16 indices per instruction at 16 bits, 8 at 32 bits. 2D tiles only. The same index list turns TENSOR_STORE_FROM_LDS into a scatter.",
   "originalText": "16 indices per instruction at 16 bits, 8 at 32 bits. 2D tiles only. The same index list turns TENSOR_STORE_FROM_LDS into a scatter.",
   "fontSize": 12.5,
   "fontFamily": 1,
   "strokeColor": "#c92a2a",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "tx144",
   "x": 42.8,
   "y": 497.8,
   "width": 914.4,
   "height": 15.6,
   "text": "The catch: indices may be arbitrary and may repeat, but out-of-bounds handling is only correct when each index is ≥ the previous one.",
   "originalText": "The catch: indices may be arbitrary and may repeat, but out-of-bounds handling is only correct when each index is ≥ the previous one.",
   "fontSize": 12.5,
   "fontFamily": 1,
   "strokeColor": "#c92a2a",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "tx145",
   "x": 53.1,
   "y": 513.4,
   "width": 893.8,
   "height": 15.6,
   "text": "Unsorted indices — exactly what a token ID or an MoE routing decision gives you — mean you must guarantee every index is in range.",
   "originalText": "Unsorted indices — exactly what a token ID or an MoE routing decision gives you — mean you must guarantee every index is in range.",
   "fontSize": 12.5,
   "fontFamily": 1,
   "strokeColor": "#c92a2a",
   "textAlign": "center",
   "autoResize": true
  }
