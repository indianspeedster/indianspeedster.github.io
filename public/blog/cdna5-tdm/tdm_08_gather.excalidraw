  {
   "type": "text",
   "id": "tx119",
   "x": 131.0,
   "y": 436.4,
   "width": 757.9,
   "height": 16.2,
   "text": "Rows arrive in the order the list names them, not in memory order: index 0 is row 9, so row 9 lands first.",
   "originalText": "Rows arrive in the order the list names them, not in memory order: index 0 is row 9, so row 9 lands first.",
   "fontSize": 13,
   "fontFamily": 1,
   "strokeColor": "#495057",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "tx120",
   "x": 120.3,
   "y": 452.7,
   "width": 779.4,
   "height": 16.2,
   "text": "Repeats are allowed, which is why row 2 appears twice. Up to 16 indices fit at 16 bits each, or 8 at 32 bits.",
   "originalText": "Repeats are allowed, which is why row 2 appears twice. Up to 16 indices fit at 16 bits each, or 8 at 32 bits.",
   "fontSize": 13,
   "fontFamily": 1,
