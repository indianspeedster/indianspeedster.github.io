   "y": 506.4,
   "width": 825.0,
   "height": 15.6,
   "text": "It is expressed in DWORDs while every other field is in data_size elements, and tile_dim0 must be a multiple of 4 bytes.",
   "originalText": "It is expressed in DWORDs while every other field is in data_size elements, and tile_dim0 must be a multiple of 4 bytes.",
