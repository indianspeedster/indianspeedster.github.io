   "y": 475.2,
   "width": 914.4,
   "height": 15.6,
   "text": "Both fields are encoded, not literal:  pad_interval  0 → 2 DWORDs, 1 → 4, … 7 → 256   ·   pad_amount  0 → 1 DWORD, 1 → 2, … 127 → 128",
   "originalText": "Both fields are encoded, not literal:  pad_interval  0 → 2 DWORDs, 1 → 4, … 7 → 256   ·   pad_amount  0 → 1 DWORD, 1 → 2, … 127 → 128",
   "fontSize": 12.5,
   "fontFamily": 1,
   "strokeColor": "#e8590c",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "tx192",
   "x": 115.0,
   "y": 490.8,
   "width": 770.0,
   "height": 15.6,
   "text": "They must both be zero or both be non-zero. Padding is memory → LDS only; there is no de-padding on the way out.",
   "originalText": "They must both be zero or both be non-zero. Padding is memory → LDS only; there is no de-padding on the way out.",
   "fontSize": 12.5,
   "fontFamily": 1,
   "strokeColor": "#e8590c",
   "textAlign": "center",
