  {
   "type": "text",
   "id": "tx220",
   "x": 554.8,
   "y": 433.6,
   "width": 214.5,
   "height": 16.2,
   "text": "edge tile hangs off the tensor",
   "originalText": "edge tile hangs off the tensor",
   "fontSize": 13,
   "fontFamily": 1,
   "strokeColor": "#868e96",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "rectangle",
   "id": "box221",
   "x": 60,
   "y": 422,
   "width": 860,
   "height": 78,
   "roundness": {
    "type": 3
   },
   "backgroundColor": "#ebfbee",
   "fillStyle": "solid",
   "strokeWidth": 1.5,
   "strokeColor": "#2b8a3e",
   "roughness": 1,
   "opacity": 100
  },
  {
   "type": "text",
   "id": "tx222",
   "x": 111.0,
   "y": 437.3,
   "width": 757.9,
   "height": 16.2,
   "text": "Ragged edges need no epilogue kernel and no pre-padded buffers, and the zeros contribute nothing to a sum.",
   "originalText": "Ragged edges need no epilogue kernel and no pre-padded buffers, and the zeros contribute nothing to a sum.",
   "fontSize": 13,
   "fontFamily": 1,
   "strokeColor": "#2b8a3e",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "tx223",
   "x": 121.8,
   "y": 453.5,
   "width": 736.5,
   "height": 16.2,
   "text": "But the bound is counted from the tile, not from the start of the array: set tensor_dim to what is left",
   "originalText": "But the bound is counted from the tile, not from the start of the array: set tensor_dim to what is left",
   "fontSize": 13,
   "fontFamily": 1,
   "strokeColor": "#2b8a3e",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "tx224",
   "x": 146.8,
   "y": 469.8,
   "width": 686.4,
   "height": 16.2,
   "text": "from global_addr, or the engine reads straight on into the next row. It guards the far end only.",
   "originalText": "from global_addr, or the engine reads straight on into the next row. It guards the far end only.",
   "fontSize": 13,
   "fontFamily": 1,
   "strokeColor": "#2b8a3e",
