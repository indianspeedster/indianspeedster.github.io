  {
   "type": "text",
   "id": "tx29",
   "x": 227.3,
   "y": 377.2,
   "width": 705.4,
   "height": 16.9,
   "text": "the wait is  ≤ N , not  = 0 : it retires the older transfer and lets the newer one keep running",
   "originalText": "the wait is  ≤ N , not  = 0 : it retires the older transfer and lets the newer one keep running",
   "fontSize": 13.5,
   "fontFamily": 3,
   "strokeColor": "#495057",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "tx30",
   "x": 28.5,
   "y": 441.8,
   "width": 943.0,
   "height": 16.9,
   "text": "Per iteration the wave issues one instruction and two scalar adds to advance global_addr. The register file holds accumulators,",
   "originalText": "Per iteration the wave issues one instruction and two scalar adds to advance global_addr. The register file holds accumulators,",
   "fontSize": 13.5,
   "fontFamily": 1,
   "strokeColor": "#495057",
   "textAlign": "center",
   "autoResize": true
  },
  {
   "type": "text",
   "id": "tx31",
   "x": 13.7,
   "y": 458.7,
   "width": 972.7,
   "height": 16.9,
   "text": "not data in flight, and TENSORcnt is 6 bits wide — 63 outstanding transfers — so the counter will not be what limits your pipeline.",
   "originalText": "not data in flight, and TENSORcnt is 6 bits wide — 63 outstanding transfers — so the counter will not be what limits your pipeline.",
   "fontSize": 13.5,
   "fontFamily": 1,
